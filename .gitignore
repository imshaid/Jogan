*.pem
*.key
.claude/settings.local.json
.claude/*.local.md

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# --- Node / web ---
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo

