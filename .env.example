# Copy to `.env` and fill in real values locally. Never commit `.env`.
# Placeholders only. Web variables also go into `web/.env.local` once the web app exists.

# --- Runtime ---
JOGAN_ENV=development                 # development | production
JOGAN_PROFILE=dev                     # data profile: tiny | dev | full | stress
JOGAN_SEED=42                         # simulation seed
JOGAN_CORS_ORIGINS=http://localhost:3000     # comma-separated exact origins; production: https://jogan-bd.vercel.app
JOGAN_CORS_ORIGIN_REGEX=                      # optional pattern, e.g. for Vercel previews; unset in production
JOGAN_BUNDLE_DIR=bundle                       # served bundle (make bundle); the Docker image has /app/bundle
JOGAN_STORE=supabase                          # supabase | memory (memory: development only, tokens "analyst"/"approver")
JOGAN_TRUSTED_PROXY_HOPS=0                    # proxies appending to X-Forwarded-For; 0 locally, 1 on Cloud Run (set in the Dockerfile)
JOGAN_DEMO_PASSWORD=<12+ characters>          # demo analyst/approver password, used by scripts/seed_demo_users.py

# --- Supabase (auth, roles, recommendation queue, audit log) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>   # browser-safe, RLS applies
SUPABASE_SECRET_KEY=<sb_secret_...>             # server only, bypasses RLS; never in the web app

# --- Google AI Studio / Gemini (free tier; synthetic data only) ---
GEMINI_API_KEY=<google-ai-studio-key>
GEMINI_MODEL_PRIMARY=                           # optional local override; default gemini-3.5-flash-lite (configs/explain/base.yaml)
GEMINI_MODEL_FALLBACK=                          # optional local override; default gemini-3.1-flash-lite, used on HTTP 429 or 5xx

# --- Web app (copy into web/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000    # production: the Cloud Run URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
NEXT_PUBLIC_MAPTILER_KEY=<maptiler-key-restricted-to-our-domains>
NEXT_PUBLIC_DEMO_PASSWORD=                      # optional: one-click demo sign-in (public by design, D-022)
